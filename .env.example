APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Keep disabled for the local HTTP demonstration. Exact proxy IPs only; no CIDR or gateway wildcard.
CYBERSHIELD_REQUIRE_HTTPS=0
CYBERSHIELD_HTTPS_PROXY_PEERS=
DB_USER=cybershield_app
CYBERSHIELD_MODE=monitor
CYBERSHIELD_SIEM_URL=
# Read-only mount of Ollama's host model cache for the optional, offline Docker assistant.
OLLAMA_MODELS_PATH=./ollama-models
CYBERSHIELD_ASSISTANT_MODEL=llama3.2:latest
# Interactive LLM deadline, seconds (2..20). Quick local answers do not use the LLM.
CYBERSHIELD_ASSISTANT_TIMEOUT_SECONDS=10
# Optional hosted Mobile Money checkout. Keep disabled without an active merchant account.
# The separate compose.payments.yaml overlay mounts the two private secret files.
PAYMENT_ENABLED=false
APP_PUBLIC_URL=
CINETPAY_SITE_ID=
