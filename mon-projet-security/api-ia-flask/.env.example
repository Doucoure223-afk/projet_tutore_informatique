# Config MySQL pour l'assistant chat (même BDD que le projet PHP)
# Copier ce fichier en .env et adapter les valeurs.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mon_projet_securite

# Variables alternatives (compatibles avec le .env du projet PHP)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=mon_projet_securite

# --- LLM pour questions libres (chat dashboard) ---
# Priorité par défaut : Gemini → Groq → OpenAI
# Pour utiliser UNIQUEMENT Groq : CHAT_LLM_PROVIDER=groq  ou  USE_GROQ_ONLY=1
# Désactiver le LLM : ENABLE_LLM_CHAT=0

# 1) Gemini (prioritaire si pas de CHAT_LLM_PROVIDER=groq)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# 2) Groq (gratuit, rapide) — https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# 3) OpenAI (fallback optionnel)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
